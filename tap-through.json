{
  "app": "A Player Mode",
  "brand": "a-player-mode",
  "about": "The app's own robot walk for every PR that changes a screen (boss-os scripts/ops/tap-through.mjs, ship-ready app-review.md). The preview's sample server lives in the browser (src/preview/server.ts): no real sign-in, purchase or production API call; every other request that is not a read is blocked.",
  "journeys": [
    {
      "name": "first-open",
      "start": "/",
      "steps": [
        { "see": "Start: reduce my load", "id": "welcome" },
        { "sweep": true }
      ]
    },
    {
      "name": "main-task",
      "start": "/",
      "steps": [
        { "tap": { "role": "button", "name": "Start: reduce my load" }, "id": "intake" },
        { "sweep": true }
      ]
    },
    {
      "name": "sample-account",
      "start": "/",
      "steps": [
        { "tap": "I already have an account", "id": "join" },
        { "sweep": true }
      ]
    },
    {
      "name": "paywall",
      "start": "/",
      "steps": [
        { "tap": { "role": "button", "name": "Start: reduce my load" } },
        { "goto": "/settings/plan" },
        { "see": "How much should APM carry?", "id": "plans" },
        { "sweep": true }
      ]
    },
    {
      "name": "settings",
      "start": "/",
      "steps": [
        { "tap": { "role": "button", "name": "Start: reduce my load" } },
        { "goto": "/settings" },
        { "wait": 1500, "id": "settings" },
        { "sweep": true }
      ]
    },
    {
      "name": "delete-my-data",
      "start": "/",
      "steps": [
        { "tap": { "role": "button", "name": "Start: reduce my load" } },
        { "goto": "/settings/privacy/export-delete" },
        { "see": "Your data should not be trapped.", "id": "export-delete" },
        { "sweep": true }
      ]
    },
    {
      "name": "signed-in",
      "start": "/",
      "steps": [
        { "tap": "I already have an account" },
        { "tap": { "role": "button", "name": "Email me a 6-digit code" } },
        { "fill": "Email address", "value": "test-tapthrough@example.com" },
        { "tap": { "role": "button", "name": "Email me a 6-digit code" } },
        { "fill": "6-digit code", "value": "123456" },
        { "tap": { "role": "button", "name": "Verify and continue" } },
        { "wait": 1500 },
        { "goto": "/settings/privacy/export-delete" },
        { "see": "Your data should not be trapped.", "id": "signed-export" },
        { "tap": { "role": "button", "name": "Generate export" } },
        { "see": "/Your export is downloaded as a-player-mode-export-/", "id": "export-done" },
        { "goto": "/today" },
        { "wait": 1500, "id": "today" },
        { "goto": "/radar" },
        { "wait": 1500, "id": "radar" },
        { "goto": "/apm" },
        { "wait": 1500, "id": "coach" },
        { "goto": "/settings/autopilot" },
        { "wait": 1500, "id": "autopilot" },
        { "sweep": true }
      ]
    }
  ],
  "route_storage": { "apm.preview.session.v1": { "kind": "account", "name": "Sam" } },
  "promises": [
    { "text": "Everything APM knows about you and everything it did, made on the spot as one file you download or share. No support ticket.", "on": "signed-in:signed-export", "built": "signed-in:export-done" }
  ],
  "native_only": [
    { "feature": "in-app purchase and Restore purchases", "why": "the web preview has no store: Restore purchases only shows where a store exists (PlanChoice), and buying is preview-only", "simulator": "a sandbox purchase on the simulator build (GitHub macOS runner, free: public repo)" },
    { "feature": "Sign in with Apple and Google", "why": "the preview's sign-in buttons make the sample account at once; the real sheets only exist on a phone", "simulator": "the simulator build" },
    { "feature": "notifications and health data", "why": "push, local notifications and HealthKit only exist on a phone", "simulator": "the simulator build" }
  ]
}
