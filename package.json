{
  "name": "aplayer-mode",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "mobile": "npm run start -w @apm/mobile",
    "mobile:ios": "npm run ios -w @apm/mobile",
    "mobile:android": "npm run android -w @apm/mobile",
    "mobile:web": "npm run web -w @apm/mobile",
    "api:dev": "npm run dev -w @apm/api",
    "api:deploy": "npm run deploy -w @apm/api",
    "runtime:verify": "node scripts/verify-runtime.mjs",
    "model:eval": "node scripts/evaluate-openrouter-routes.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "presubmit:ios": "node scripts/presubmit-ios.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
