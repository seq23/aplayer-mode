{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_APM_API_URL": "https://api.aplayermode.com",
        "EXPO_PUBLIC_TERMS_URL": "https://app.aplayermode.com/terms",
        "EXPO_PUBLIC_PRIVACY_POLICY_URL": "https://app.aplayermode.com/privacy",
        "EXPO_PUBLIC_APM_DISTRIBUTION": "store"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_APM_API_URL": "https://api.aplayermode.com",
        "EXPO_PUBLIC_TERMS_URL": "https://app.aplayermode.com/terms",
        "EXPO_PUBLIC_PRIVACY_POLICY_URL": "https://app.aplayermode.com/privacy",
        "EXPO_PUBLIC_APM_DISTRIBUTION": "store"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
