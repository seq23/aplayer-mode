{
  "expo": {
    "name": "A Player Mode",
    "slug": "aplayer-mode",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "aplayermode",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow A Player Mode to read calendars you choose so it can understand schedule constraints and notice conflicts."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "apm-attention"
        }
      ],
      "expo-sqlite",
      "expo-apple-authentication",
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.aplayermode.app",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.aplayermode.app",
      "permissions": [
        "READ_CALENDAR"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
