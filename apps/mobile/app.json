{
  "expo": {
    "name": "A Player Mode",
    "slug": "aplayer-mode",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "aplayermode",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow A Player Mode to read calendars you choose so it can understand schedule constraints and notice conflicts."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "apm-attention"
        }
      ],
      "expo-sqlite",
      "expo-apple-authentication",
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.aplayermode.app",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.aplayermode.app",
      "permissions": [
        "READ_CALENDAR"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E1C19"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "A Player Mode",
      "shortName": "APM",
      "themeColor": "#1E1C19",
      "backgroundColor": "#E9E5DE",
      "favicon": "./public/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png"
  }
}
