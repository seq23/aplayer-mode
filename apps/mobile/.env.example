# Public mobile configuration only. These values are bundled into the app and are not secrets.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
EXPO_PUBLIC_APM_API_URL=https://api.aplayermode.com

# Never place OPENROUTER_API_KEY, Supabase service-role/secret keys,
# database passwords, Cloudflare API tokens, or OAuth client secrets here.
