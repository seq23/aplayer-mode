# Copy to services/api/.dev.vars for local development only.
# Never commit real secret values.

# Supabase project configuration. The publishable key is designed for client/server use
# with Row Level Security; keep service-role/secret keys out of this app unless a future
# server-only requirement explicitly justifies one.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Local-only auth bypass. Never configure this in staging/production.
AUTH_DEV_BYPASS_USER_ID=local-user

# Public application/runtime configuration.
ALLOWED_ORIGIN=
APP_PUBLIC_URL=

# Server-only AI secret.
OPENROUTER_API_KEY=

# Server-only connector credential encryption + OAuth state signing secrets.
CONNECTOR_CREDENTIAL_KEY=
OAUTH_STATE_SECRET=

# Google OAuth server credentials.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Microsoft OAuth server credentials.
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=
MICROSOFT_TENANT=common

# Server-side Expo push credential/token when required by the delivery path.
EXPO_ACCESS_TOKEN=

# Action execution is fail-closed. Preparing recommendations/drafts may still be allowed,
# but provider-side execution requires BOTH the global switch and the documented domain switch.
GLOBAL_ACTION_EXECUTION=false
ACTION_CALENDAR_EXECUTION=false
ACTION_EMAIL_EXECUTION=false
