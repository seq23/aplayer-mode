{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aplayer-mode-api",
  "main": "src/entry.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // BHPC Morning Trigger: every 15 minutes the scheduled handler (src/entry.ts) prints the
  // agenda for users whose local wake time has arrived and sends one push per user per day.
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "env": {
    "staging": {
      "name": "aplayer-mode-api-staging",
      "triggers": { "crons": ["*/15 * * * *"] }
    },
    "production": {
      "name": "aplayer-mode-api",
      "triggers": { "crons": ["*/15 * * * *"] },
      // Phase E go-live (docs/33 §8). api./app. are scoped out of the apex → BHPC 301 by the
      // zone redirect rules matching http.host (apex and www only), checked 2026-10-07.
      "routes": [{ "pattern": "api.aplayermode.com", "custom_domain": true }],
      // Public values only (the publishable key ships in every app build). Secrets are set with
      // `wrangler secret put` (scripts/deploy-api-production.sh); BILLING_ALLOW_SANDBOX is never set here.
      "vars": {
        "SUPABASE_URL": "https://klzbnchgoqmnwsgolwoe.supabase.co",
        "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_k1YVCTt8hL0gBlWbf7lpYQ__lbnKGt8",
        "ALLOWED_ORIGIN": "https://app.aplayermode.com",
        "APP_PUBLIC_URL": "https://app.aplayermode.com",
        "APP_REVIEW_EMAIL": "appreview@aplayermode.com",
        "REVENUECAT_PROJECT_ID": "proj2c0586cf"
      }
    }
  }

  // Runtime configuration is supplied by Cloudflare environment-specific variables/secrets.
  // Staging and production are deliberately distinct Workers; never use an environment label
  // while deploying the same Worker behind the scenes.
  //
  // Deployment injects __APM_BUILD_SHA__ as a build-time Wrangler define. The health response
  // exposes that immutable value so evidence workflows can prove which source commit is live.
  //
  // Required for authenticated Life Graph routes:
  // SUPABASE_URL
  // SUPABASE_PUBLISHABLE_KEY
  //
  // Server-only, for the scheduled Morning Trigger (no user JWT exists in a cron run):
  // SUPABASE_SECRET_KEY
  //
  // Server-only, Phase D billing (docs/33; Phase E sets it): the RevenueCat webhook
  // Authorization value, >= 32 random characters. Without it the webhook answers 503.
  // REVENUECAT_WEBHOOK_SECRET
  // Staging only: BILLING_ALLOW_SANDBOX=true accepts RevenueCat SANDBOX events.
  // Production too: BILLING_SANDBOX_TESTER_IDS (secret) = comma-separated APM user ids whose
  // SANDBOX (test-card) events are honoured; every other sandbox event stays ignored.
  // REVENUECAT_API_V2_KEY (secret, customer-information read): web customer-portal links.
  //
  // Server-only inference secret when OpenRouter goes live:
  // OPENROUTER_API_KEY
  //
  // Supabase remains the durable data/auth platform; Cloudflare remains the APM API,
  // privacy, policy and model-routing boundary.
}
