{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aplayer-mode-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  }

  // Runtime configuration is supplied by Cloudflare environment variables/secrets.
  // Required for authenticated Life Graph routes:
  // SUPABASE_URL
  // SUPABASE_PUBLISHABLE_KEY
  //
  // Server-only inference secret when OpenRouter goes live:
  // OPENROUTER_API_KEY
  //
  // Supabase remains the durable data/auth platform; Cloudflare remains the APM API,
  // privacy, policy and model-routing boundary.
}
