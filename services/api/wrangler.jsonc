{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aplayer-mode-api",
  "main": "src/entry.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false }
  },
  // BHPC Morning Trigger: every 15 minutes the scheduled handler (src/entry.ts) prints the
  // agenda for users whose local wake time has arrived and sends one push per user per day.
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "env": {
    "staging": {
      "name": "aplayer-mode-api-staging",
      "triggers": { "crons": ["*/15 * * * *"] },
      "ratelimits": [
        { "name": "RECONCILE_LIMITER", "namespace_id": "4101", "simple": { "limit": 6, "period": 60 } },
        { "name": "PAID_CALL_LIMITER", "namespace_id": "4103", "simple": { "limit": 20, "period": 60 } }
      ]
    },
    "production": {
      "name": "aplayer-mode-api",
      "triggers": { "crons": ["*/15 * * * *"] },
      // Phase E go-live (docs/33 §8). api./app. are scoped out of the apex → BHPC 301 by the
      // zone redirect rules matching http.host (apex and www only), checked 2026-10-07.
      "routes": [{ "pattern": "api.aplayermode.com", "custom_domain": true }],
      // POST /v1/billing/reconcile: 6 per user per minute (RECONCILE_LIMIT in src/billing.ts).
      "ratelimits": [
        { "name": "RECONCILE_LIMITER", "namespace_id": "4102", "simple": { "limit": 6, "period": 60 } },
        // Every route that can reach a billed model: 20 per user per minute (PAID_CALL_LIMITS in src/paidCalls.ts).
        { "name": "PAID_CALL_LIMITER", "namespace_id": "4104", "simple": { "limit": 20, "period": 60 } }
      ],
      // Public values only (the publishable key ships in every app build). Secrets are set with
      // `wrangler secret put` (scripts/deploy-api-production.sh); BILLING_ALLOW_SANDBOX is never set here.
      "vars": {
        "SUPABASE_URL": "https://klzbnchgoqmnwsgolwoe.supabase.co",
        "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_k1YVCTt8hL0gBlWbf7lpYQ__lbnKGt8",
        "ALLOWED_ORIGIN": "https://app.aplayermode.com",
        "APP_PUBLIC_URL": "https://app.aplayermode.com",
        "GOOGLE_OAUTH_REDIRECT_URI": "https://api.aplayermode.com/v1/oauth/google/callback",
        "MICROSOFT_OAUTH_REDIRECT_URI": "https://api.aplayermode.com/v1/oauth/microsoft/callback",
        "APP_REVIEW_EMAIL": "appreview@aplayermode.com",
        // Review sign-in closes at this moment (src/reviewLogin.ts; RUNBOOK "Store review sign-in").
        // Set 27 Nov 2026 for the App Store review waiting since 21 Nov and the Play review open since
        // 24 Nov: their end is assumed by 17 Dec, plus 14 days. A new review sets a new date.
        "APP_REVIEW_UNTIL": "2026-12-31T00:00:00Z",
        "REVENUECAT_PROJECT_ID": "proj2c0586cf",
        "SUITE_MAIL_DAILY_CEILING": "2000",
        // Action Engine + Autopilot switches (docs/26 §8, docs/31). Autopilot is calendar only: the
        // two classes below are also activated in autopilot_action_classes (migration 0106).
        // Life graph (27 Nov 2026): Executive Suite goal-checklist steps and task moves. They change
        // only APM's own records (apm_service_apply_suite_life_graph, 0101), each one only after the
        // person taps Approve at level 4, and call no model. Email stays off. "false" kills a domain.
        "GLOBAL_ACTION_EXECUTION": "true",
        "ACTION_CALENDAR_EXECUTION": "true",
        "ACTION_LIFE_GRAPH_EXECUTION": "true",
        "AUTOPILOT_EXECUTION": "true",
        "AUTOPILOT_ENABLED_CLASSES": "calendar.reschedule,calendar.create"
      }
    }
  }

  // Runtime configuration is supplied by Cloudflare environment-specific variables/secrets.
  // Staging and production are deliberately distinct Workers; never use an environment label
  // while deploying the same Worker behind the scenes.
  //
  // Deployment injects __APM_BUILD_SHA__ as a build-time Wrangler define. The health response
  // exposes that immutable value so evidence workflows can prove which source commit is live.
  //
  // Required for authenticated Life Graph routes:
  // SUPABASE_URL
  // SUPABASE_PUBLISHABLE_KEY
  //
  // Server-only, for the scheduled Morning Trigger (no user JWT exists in a cron run):
  // SUPABASE_SECRET_KEY
  //
  // Server-only, Phase D billing (docs/33; Phase E sets it): the RevenueCat webhook
  // Authorization value, >= 32 random characters. Without it the webhook answers 503.
  // REVENUECAT_WEBHOOK_SECRET
  // Staging only: BILLING_ALLOW_SANDBOX=true accepts RevenueCat SANDBOX events.
  // Production: App Store and Google Play SANDBOX events are honoured for anyone (App Review buys
  // with sandbox receipts; migration 0109 tags them and keeps them off paid plans and Founding 100).
  // BILLING_SANDBOX_TESTER_IDS (secret) = comma-separated APM user ids whose WEB (test-card) SANDBOX
  // events are honoured; every other sandbox event stays ignored.
  // REVENUECAT_API_V2_KEY (secret, customer-information read): web customer-portal links.
  //
  // Server-only inference secret when OpenRouter goes live:
  // OPENROUTER_API_KEY
  //
  // Supabase remains the durable data/auth platform; Cloudflare remains the APM API,
  // privacy, policy and model-routing boundary.
}
